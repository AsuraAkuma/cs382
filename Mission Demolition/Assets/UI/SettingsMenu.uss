.title {
    font-size: 120px;
    -unity-text-align: middle-center;
    width: 100%;
    color: rgb(188, 188, 188);
    top: 10%;
}

.Sliders {
    flex-grow: 1;
    width: 50%;
    top: 15%;
    height: auto;
    max-height: 50%;
    left: 25%;
}

.Slider {
    width: 80%;
    font-size: 40px;
    color: rgb(188, 188, 188);
    left: 10%;
}

.button {
    width: 30%;
    height: 10%;
    font-size: 40px;
    color: rgb(188, 188, 188);
    background-color: rgb(101, 0, 0);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    left: 35%;
}
