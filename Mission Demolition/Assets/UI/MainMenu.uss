.title {
    font-size: 120px;
    -unity-text-align: middle-center;
    width: 100%;
    color: rgb(188, 188, 188);
    top: 10%;
}

.ButtonContainer {
    flex-grow: 1;
    width: 20%;
    left: 40%;
    top: 20%;
}

.button {
    width: 100%;
    height: 10%;
    font-size: 50px;
    color: rgb(188, 188, 188);
    background-color: rgb(101, 0, 0);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    margin-bottom: 10%;
}

.BombImage {
    flex-grow: 1;
    background-image: url("project://database/Assets/bomb.png?fileID=4191568626368657106&guid=37bc1ad9b041ff24bb20d0f6926febdd&type=3#pngimg.com - bomb_PNG26_0");
    background-size: 99px 100px;
    -unity-background-scale-mode: stretch-to-fill;
    position: absolute;
    top: 10%;
    left: 10%;
}
