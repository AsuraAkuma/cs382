.header-labels {
    width: 20%;
    max-height: 50px;
    height: 50px;
    top: 1%;
    left: 1%;
    flex-direction: row;
    color: rgb(255, 255, 255);
    font-size: 40px;
}

.header {
    flex-grow: 1;
    flex-direction: row;
    max-height: 50px;
}

.start {
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    font-size: 70px;
    top: 40%;
}
