.root {
    width: 100%;
    height: 100%;
    background-color: rgba(20, 20, 40, 0.95);
}

.screen {
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.hidden {
    display: none;
}

.title {
    font-size: 72px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 80px;
}

.subtitle {
    font-size: 48px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 40px;
}

.main-button {
    width: 300px;
    height: 80px;
    font-size: 24px;
    -unity-font-style: bold;
    background-color: rgb(60, 120, 200);
    border-radius: 10px;
    color: white;
    margin: 15px;
    transition: all 0.2s;
}

.main-button:hover {
    background-color: rgb(80, 140, 220);
    scale: 1.05;
}

.secondary-button {
    width: 200px;
    height: 60px;
    font-size: 20px;
    background-color: rgb(100, 100, 100);
    border-radius: 10px;
    color: white;
    margin: 15px;
}

.secondary-button:hover {
    background-color: rgb(120, 120, 120);
}

.input-container {
    width: 400px;
    margin: 15px;
}

.input-label {
    font-size: 18px;
    color: white;
    margin-bottom: 5px;
}

TextField {
    height: 40px;
    font-size: 18px;
    background-color: rgb(240, 240, 240);
    border-width: 1px;
    border-color: rgb(200, 200, 200);
    border-radius: 5px;
}
