            </engine:VisualElement>
            <engine:VisualElement name="employeeManagerSection" class="employeeManagerSection" style="margin-top: 2%; flex-direction: column;">
                <engine:Label text="Stats" name="employeeManagerSectionHeader" class="employeeManagerSectionHeader" />
                <engine:VisualElement name="EMStatContainer" style="max-height: 85%; height: 80%; top: 5%; flex-direction: row;">
                    <engine:VisualElement name="EMStatContainerLeft" style="flex-grow: 1; width: 50%; max-width: 50%; height: 100%; max-height: 100%;">
                        <engine:VisualElement name="EMSpeedStat" class="EMStat">
