                <engine:ScrollView name="employeeManagerModifiers" style="max-height: 84%;">
                    <engine:Label text="Modifier Name: Description&#10;Modifier Name: Description&#10;Modifier Name: Description&#10;Modifier Name: Description&#10;Modifier Name: Description&#10;Modifier Name: Description&#10;Modifier Name: Description&#10;Modifier Name: Description&#10;Modifier Name: Description" name="EMModifiers" style="width: 95%; height: auto; left: 2.5%; color: rgb(255, 255, 255); font-size: 18%; white-space: pre-wrap;" />
                </engine:ScrollView>
            </engine:VisualElement>
            <engine:VisualElement name="EMButtonContainer" style="flex-grow: 1; flex-direction: column; position: absolute; width: 35%; left: 102%; max-height: 38%; height: 30%; top: 10%;">
                <engine:Button text="Edit Name" name="EMEditNameButton" class="EMButton" />
                <engine:Button text="Edit Department" name="EMEditDepartmentButton" class="EMButton" />
                <engine:Button text="Promote" name="EMPromoteButton" class="EMButton" style="border-left-color: rgb(59, 255, 0); border-right-color: rgb(59, 255, 0); border-top-color: rgb(59, 255, 0); border-bottom-color: rgb(59, 255, 0);" />
                <engine:Button text="Fire" name="EMFireButton" class="EMButton" style="border-left-color: rgb(255, 0, 0); border-right-color: rgb(255, 0, 0); border-top-color: rgb(255, 0, 0); border-bottom-color: rgb(255, 0, 0);" />
            </engine:VisualElement>
            <engine:VisualElement name="EditNamePanel" class="EditPanel" style="display: none;">
                <engine:Label text="Edit Name" name="EditPanelHeader" class="EditPanelHeader" />
                <engine:Label text="Current: Employee Name" name="EditNamePanelOldValue" class="EditPanelOldValue" />
                <engine:TextField placeholder-text="New Name" name="EditNamePanelInput" class="EditPanelInput" />
                <engine:Button text="Confirm" name="editNamePanelConfirmButton" class="EditPanelButton" />
                <engine:VisualElement name="editNamePanelCancelButton" class="EditPanelCancel" />
            </engine:VisualElement>
            <engine:VisualElement name="EditDepartmentPanel" class="EditPanel" style="display: none;">
                <engine:Label text="Edit Department" name="EditPanelHeader" class="EditPanelHeader" />
                <engine:Label text="Current: HR" name="EditDepartmentPanelOldValue" class="EditPanelOldValue" />
