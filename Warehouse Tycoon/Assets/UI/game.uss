.departmentManagerContainer {
    flex-grow: 1;
    flex-direction: row;
    max-height: 80%;
    top: auto;
    margin-top: 5%;
}

.departmentManagerButtons {
    flex-grow: 1;
    width: auto;
    max-width: 15%;
    margin-left: 5%;
}

.departmentManagerButtonUp {
    background-color: rgb(31, 31, 31);
    /* Uncomment the line below if the background image is needed */
    /* background-image: url("project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=1169890249420208065&guid=52ad37434abc04c4a89313c780229724&type=3#arrow-up"); */
    min-height: 4%;
    width: 100%;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    top: 32.5%;
}

.departmentManagerButtonDown {
    background-color: rgb(31, 31, 31);
    min-height: 4%;
    width: 100%;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    top: 60%;
}

/* Add additional styling for UI elements needing explicit dimensions */
.headerButton {
    min-height: 20px;
    height: auto;
}

.departmentEmployeeList {
    min-height: 10px;
    height: auto;
    flex-grow: 1;
}

.departmentStats {
    min-height: 20px;
    height: auto;
    flex-grow: 1;
}

/* Fix for potential texture-related issues */
.unity-builder-viewport {
    min-height: 1px;
    min-width: 1px;
}
