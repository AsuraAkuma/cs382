* {
    margin: 0;
    padding: 0;
    border-width: 0;
    border-color: rgba(0, 0, 0, 0);
}

.unity-builder-viewport {
    min-height: 1px;
    min-width: 1px;
}

.unity-base-slider__tracker {
    width: 10px;
    margin: 0;
    padding: 0;
    background-color: rgb(31, 31, 31);
    position: relative;
}

.unity-base-slider__drag-container {
    width: 10px;
    margin: 0;
    padding: 0;
    background-color: rgb(31, 31, 31);
    position: relative;
}

.unity-base-field__input {
    width: 10px;
    margin: 0;
    padding: 0;
    background-color: rgb(31, 31, 31);
    position: relative;
}

.unity-base-field {
    width: 10px;
    margin: 0;
    padding: 0;
    background-color: rgb(31, 31, 31);
    position: relative;
}

.unity-scroller__slider {
    width: 10px;
    margin: 0;
    padding: 0;
    background-color: rgb(31, 31, 31);
    position: relative;
}

.unity-base-slider--vertical {
    width: 10px;
    margin: 0;
    padding: 0;
    background-color: rgb(31, 31, 31);
    position: relative;
}

.unity-scroller__slider {
    width: 10px;
    margin: 0;
    padding: 0;
    background-color: rgb(31, 31, 31);
    position: relative;
}

.unity-base-slider--vertical {
    width: 10px;
    margin: 0;
    padding: 0;
    background-color: rgb(31, 31, 31);
    position: relative;
}

.unity-scroller--vertical {
    width: 10px;
    margin: 0;
    padding: 0;
    background-color: rgb(31, 31, 31);
    position: relative;
}

.unity-scroller__low-button {
    display: none;
}

.unity-scroller__high-button {
    display: none;
}

.unity-scroll-view {
    margin: 0;
    padding: 0;
    overflow: hidden;
}

.unity-scroll-view__content-container {
    margin-right: 10px;
    height: 100%;
    max-height: 100%;
}

.unity-scroller--vertical {
    border-left-width: 1px;
    border-left-color: rgb(70, 70, 70);
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 10px;
}

.unity-scroller--horizontal {
    border-top-width: 1px;
    border-top-color: rgb(70, 70, 70);
}

.unity-base-slider__dragger {
    background-color: rgb(100, 100, 100);
    border-radius: 2px;
    margin: 0;
    width: 10px;
}

.unity-base-slider__dragger:hover {
    background-color: rgb(255, 141, 0);
}

.unity-base-slider__dragger:active {
    background-color: rgb(255, 141, 0);
}

.unity-base-slider__dragger:focus {
    background-color: rgb(255, 141, 0);
}

.unity-base-slider__dragger:active {
    background-color: rgb(255, 141, 0);
}

.unity-scroll-view__content-viewport {
    margin: 0;
    padding: 0;
}

.body {
    flex-grow: 1;
    width: 100%;
    max-height: 100%;
    height: 100%;
}

.header {
    flex-grow: 1;
    max-height: 7%;
    height: 7%;
    width: 100%;
    flex-direction: row;
    background-color: rgb(46, 46, 46);
}

.headerLabel {
    color: rgb(255, 255, 255);
    font-size: 250%;
    -unity-text-align: middle-left;
    left: 1%;
    width: 25%;
}

.upgradeContainer {
    flex-grow: 1;
    width: 90%;
    max-height: none;
    left: 5%;
    top: auto;
    background-color: rgb(31, 31, 31);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    flex-direction: row;
    margin-top: 4%;
    height: auto;
    padding-top: 0;
    padding-bottom: 0;
    min-height: 60px;
}

.upgradeLevel {
    width: 25%;
    height: 100%;
    max-height: 100%;
    bottom: 0;
    min-height: 100%;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    font-size: 20px;
}

.upgradeName {
    width: 50%;
    border-right-color: rgb(255, 255, 255);
    border-right-width: 2px;
    height: 100%;
    max-height: 100%;
    bottom: 0;
    min-height: 100%;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    border-left-color: rgb(255, 255, 255);
    border-left-width: 2px;
    font-size: 20px;
}

.canUpgrade {
    color: rgb(59, 255, 0);
}

.cannotUpgrade {
    color: rgb(255, 0, 0);
}

.upgradeList {
    max-height: 80%;
    height: auto;
    min-height: auto;
}

.department {
    flex-grow: 1;
    width: 95%;
    left: 2.5%;
    max-height: 250px;
    min-height: 250px;
    margin-top: 1.25%;
    background-color: rgb(46, 46, 46);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(255, 141, 0);
    border-right-color: rgb(255, 141, 0);
    border-top-color: rgb(255, 141, 0);
    border-bottom-color: rgb(255, 141, 0);
    height: 250px;
    margin-bottom: 1.25%;
}

.departmentHeader {
    flex-grow: 1;
    border-bottom-color: rgb(255, 255, 255);
    border-bottom-width: 2px;
    width: 100%;
    max-height: 15%;
    min-height: auto;
    height: 15%;
}

.departmentHeaderLabel {
    width: 20%;
    max-height: 100%;
    height: 100%;
    color: rgb(255, 255, 255);
    font-size: 150%;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.departmentManager {
    flex-grow: 1;
    width: 20%;
    height: 100%;
    max-height: 100%;
    border-right-color: rgb(255, 255, 255);
    border-right-width: 2px;
    max-width: 20%;
}

.departmentManagerImg {
    flex-grow: 1;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-left-color: rgb(255, 141, 0);
    border-right-color: rgb(255, 141, 0);
    border-top-color: rgb(255, 141, 0);
    border-bottom-color: rgb(255, 141, 0);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    width: auto;
    max-height: 100%;
    max-width: 70%;
    margin-left: 5%;
    height: 100%;
    min-height: 50px;
}

.departmentManagerContainer {
    flex-grow: 1;
    flex-direction: row;
    max-height: 80%;
    top: auto;
    margin-top: 5%;
}

.departmentManagerButtons {
    flex-grow: 1;
    width: auto;
    max-width: 15%;
    margin-left: 5%;
}

.departmentManagerButtonUp {
    background-color: rgba(31, 31, 31, 0);
    min-height: auto;
    width: 100%;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    top: 30%;
    max-height: 15%;
    height: 15%;
    background-image: url("project://database/Assets/square-caret-up-regular.png?fileID=6709490733029022491&guid=eef6e1ec2d2d2024ba5db7d777f3a147&type=3#square-caret-up-regular_0");
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.departmentManagerButtonDown {
    min-height: auto;
    width: 100%;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    top: 37.5%;
    height: 15%;
    max-height: 15%;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/square-caret-down-regular.png?fileID=5498669254548924694&guid=a75aeb9b20fafab4c8bcb7dd1c6d4679&type=3#square-caret-down-regular_0");
}

.headerButton {
    min-height: 20px;
    height: auto;
}

.departmentEmployeeList {
    min-height: 10px;
    height: auto;
    flex-grow: 1;
}

.departmentStats {
    min-height: 20px;
    height: auto;
    flex-grow: 1;
}

.managerLabel {
    width: 70%;
    left: 5%;
    max-height: 20%;
    height: 20%;
    color: rgb(255, 255, 255);
    font-size: 15px;
    -unity-text-align: middle-center;
}

.panelNav {
    flex-grow: 1;
    flex-direction: row;
}

.panelNavButton {
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    max-height: 100%;
    background-size: 50% 70%;
    background-position-y: top 10%;
    -unity-text-align: lower-center;
    height: 100%;
    min-height: 100%;
    color: rgb(255, 255, 255);
    font-size: 15px;
    -unity-font-style: normal;
    margin-left: 2%;
    width: 30%;
}

.departmentSection {
    flex-grow: 1;
    width: 100%;
    max-height: 85%;
    height: 85%;
    flex-direction: row;
}

.departmentEmployees {
    flex-grow: 1;
    flex-direction: row;
}

.departmentEmployeeList {
}

.departmentEmployee {
    flex-grow: 1;
    width: 20%;
    height: 100%;
    max-height: 100%;
    margin-left: 2%;
}
