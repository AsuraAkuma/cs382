* {
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    border-width: 0;
    border-color: rgba(0, 0, 0, 0);
}

.unity-builder-viewport {
    min-height: 1px;
    min-width: 1px;
}

.unity-base-slider__tracker {
    width: 10px;
    margin: 0;
    padding: 0;
    background-color: rgb(31, 31, 31);
    position: relative;
}

.unity-base-slider__drag-container {
    width: 10px;
    margin: 0;
    padding: 0;
    background-color: rgb(31, 31, 31);
    position: relative;
}

.unity-base-field__input {
    width: 10px;
    margin: 0;
    padding: 0;
    background-color: rgb(31, 31, 31);
    position: relative;
}

.unity-base-field {
    margin: 0;
    padding: 0;
}

.unity-scroller__slider {
    width: 10px;
    margin: 0;
    padding: 0;
    background-color: rgb(31, 31, 31);
    position: relative;
}

.unity-base-slider--vertical {
    width: 10px;
    margin: 0;
    padding: 0;
    background-color: rgb(31, 31, 31);
    position: relative;
}

.unity-base-slider--horizontal {
    width: 10px;
    margin: 0;
    padding: 0;
    background-color: rgb(31, 31, 31);
    position: relative;
}

.unity-scroller__slider {
    width: 10px;
    margin: 0;
    padding: 0;
    background-color: rgb(31, 31, 31);
    position: relative;
}

.unity-base-slider--vertical {
    width: 10px;
    margin: 0;
    padding: 0;
    background-color: rgb(31, 31, 31);
    position: relative;
}

.unity-base-slider--horizontal {
    width: 10px;
    margin: 0;
    padding: 0;
    background-color: rgb(31, 31, 31);
    position: relative;
}

.unity-scroller--vertical {
    width: 10px;
    margin: 0;
    padding: 0;
    background-color: rgb(31, 31, 31);
    position: relative;
}

.unity-scroller--horizontal {
    width: 10px;
    margin: 0;
    padding: 0;
    background-color: rgb(31, 31, 31);
    position: relative;
}

.unity-scroller__low-button {
    display: none;
}

.unity-scroller__high-button {
    display: none;
}

.unity-scroll-view {
    margin: 0;
    padding: 0;
    overflow: hidden;
}

.unity-scroll-view__content-container {
    margin-right: 10px;
    height: 100%;
    max-height: 100%;
}

.unity-scroller--vertical {
    border-left-width: 1px;
    border-left-color: rgb(70, 70, 70);
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 10px;
}

.unity-scroller--horizontal {
    border-left-width: 1px;
    border-left-color: rgb(70, 70, 70);
    height: 10px;
    width: 100%;
}

.unity-base-slider__dragger {
    background-color: rgb(100, 100, 100);
    border-radius: 2px;
    margin: 0;
    width: 10px;
}

.unity-base-slider__dragger:hover {
    background-color: rgb(255, 141, 0);
}

.unity-base-slider__dragger:active {
    background-color: rgb(255, 141, 0);
}

.unity-base-slider__dragger:focus {
    background-color: rgb(255, 141, 0);
}

.unity-base-slider__dragger:active {
    background-color: rgb(255, 141, 0);
}

.unity-scroll-view__content-viewport {
    margin: 0;
    padding: 0;
}

.body {
    flex-grow: 1;
    width: 100%;
    max-height: 100%;
    height: 100%;
}

.header {
    flex-grow: 1;
    max-height: 7%;
    height: 7%;
    width: 100%;
    flex-direction: row;
    background-color: rgb(46, 46, 46);
    top: 0;
    min-height: 7%;
}

.headerLabel {
    color: rgb(255, 255, 255);
    font-size: 250%;
    -unity-text-align: middle-left;
    left: 1%;
    width: 25%;
}

.upgradePanel {
    flex-grow: 1;
    width: 20%;
    height: 93%;
    max-height: none;
    background-color: rgba(46, 46, 46, 0);
    position: absolute;
    border-right-color: rgb(255, 141, 0);
    border-right-width: 2px;
    top: 7%;
}

.upgradeLevel {
    width: 25%;
    height: 100%;
    max-height: 100%;
    bottom: 0;
    min-height: 100%;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    font-size: 100%;
}

.upgradeHeader {
    font-size: 200%;
    color: rgb(59, 255, 0);
    -unity-text-align: middle-center;
    top: auto;
    width: 90%;
    left: 5%;
    border-bottom-color: rgb(255, 255, 255);
    border-bottom-width: 2px;
    margin-top: 0;
    padding-bottom: 2%;
    max-height: 7%;
    height: 7%;
    max-width: none;
}

.upgradeContainer {
    flex-grow: 1;
    width: 90%;
    max-height: 10%;
    left: 5%;
    top: auto;
    background-color: rgb(31, 31, 31);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    flex-direction: row;
    margin-top: 4%;
    height: 10%;
    padding-top: 0;
    padding-bottom: 0;
    min-height: 10%;
}

.upgradeName {
    width: 50%;
    border-right-color: rgb(255, 255, 255);
    border-right-width: 2px;
    height: 100%;
    max-height: 100%;
    bottom: 0;
    min-height: 100%;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    border-left-color: rgb(255, 255, 255);
    border-left-width: 2px;
    font-size: 20px;
}

.storeItemName {
    width: 75%;
    border-right-color: rgb(255, 255, 255);
    border-right-width: 2px;
    height: 100%;
    max-height: 100%;
    bottom: 0;
    min-height: 100%;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    border-left-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    font-size: 130%;
    white-space: pre-wrap;
}

.canUpgrade {
    color: rgb(59, 255, 0);
}

.cannotUpgrade {
    color: rgb(255, 0, 0);
}

.upgradeList {
    max-height: 82%;
    height: 82%;
    min-height: 82%;
    width: 100%;
}

.department {
    flex-grow: 1;
    width: 95%;
    left: 2.5%;
    max-height: 250px;
    min-height: 250px;
    margin-top: 1.25%;
