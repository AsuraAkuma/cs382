    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    background-color: rgb(46, 46, 46);
    color: rgb(255, 255, 255);
    border-left-color: rgb(255, 141, 0);
    border-right-color: rgb(255, 141, 0);
    border-top-color: rgb(255, 141, 0);
    border-bottom-color: rgb(255, 141, 0);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    margin-top: 2%;
}

.EditPanel {
    flex-grow: 1;
    position: absolute;
    width: 50%;
    background-color: rgb(31, 31, 31);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(255, 141, 0);
    border-right-color: rgb(255, 141, 0);
    border-top-color: rgb(255, 141, 0);
    border-bottom-color: rgb(255, 141, 0);
    height: 30%;
    top: 10%;
    left: 32%;
}

.EditPanelHeader {
    width: 100%;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    font-size: 140%;
    margin-top: 2%;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 2px;
    border-left-width: 0;
    border-bottom-color: rgb(255, 141, 0);
    height: 20%;
}

.EditPanelOldValue {
    color: rgb(255, 255, 255);
    font-size: 100%;
    -unity-text-align: middle-center;
    margin-top: 2%;
    white-space: pre-wrap;
}

.EditPanelInput {
    background-color: rgb(109, 109, 109);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    width: 95%;
    color: rgb(255, 255, 255);
    font-size: 100%;
    overflow: hidden;
    top: 5%;
    left: 2.5%;
    height: 20%;
    border-left-color: rgb(255, 141, 0);
    border-right-color: rgb(255, 141, 0);
    border-top-color: rgb(255, 141, 0);
    border-bottom-color: rgb(255, 141, 0);
    display: flex;
}

.EditPanelButton {
    background-color: rgb(46, 46, 46);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(255, 141, 0);
    border-right-color: rgb(255, 141, 0);
    border-top-color: rgb(255, 141, 0);
    border-bottom-color: rgb(255, 141, 0);
    width: 50%;
    height: 20%;
    left: 25%;
    top: 15%;
    color: rgb(255, 255, 255);
}

.EditPanelCancel {
    flex-grow: 1;
    position: absolute;
    top: 0;
    left: 90%;
    width: 8%;
    max-width: 10%;
    height: 22%;
    background-image: url("project://database/Assets/x-solid.png?fileID=-6459739394519215524&guid=706233d34ee7ba84dad835acd3794055&type=3#x-solid_0");
    background-size: 100% 60%;
}
